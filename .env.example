SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///supportsphere.db
APP_ENV=development
FLASK_DEBUG=false
SESSION_COOKIE_SECURE=false
MAIL_SUPPRESS_SEND=true
